APP_ENV=local
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCS_ENABLED=true

API_HOST=0.0.0.0
API_PORT=8000

MYSQL_DATABASE=open_source_intelligence
MYSQL_USER=app
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_URL=mysql+pymysql://app:replace-with-a-local-database-password@mysql:3306/open_source_intelligence?charset=utf8mb4

REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-characters
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
GITHUB_API_BASE=https://api.github.com
HUGGINGFACE_API_BASE=https://hf-mirror.com/api

PIPELINE_SCHEDULE_ENABLED=true
PIPELINE_SCHEDULE_HOUR=2
PIPELINE_SCHEDULE_MINUTE=0
PIPELINE_COLLECT_LIMIT=20
PIPELINE_TASK_MAX_RETRIES=2
PIPELINE_RETRY_BACKOFF_SECONDS=30

# Research Agent runtime.
# The default "offline" provider is a deterministic stub that needs no network or credential.
# Switch to "openai_compatible" only after filling AGENT_API_BASE and AGENT_API_KEY.
AGENT_ENABLED=true
AGENT_PROVIDER=offline
AGENT_MODEL=offline-deterministic-v1
AGENT_API_BASE=
AGENT_API_KEY=
AGENT_PROMPT_VERSION=v1
AGENT_MAX_LOOPS=4
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_COST=0.50
AGENT_MAX_CANDIDATES=5
AGENT_REQUEST_TIMEOUT_SECONDS=60
AGENT_PROMPTS_DIR=

PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
