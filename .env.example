APP_NAME=open-source-intelligence-agent
APP_ENV=local
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCS_ENABLED=true

API_HOST=0.0.0.0
API_PORT=8000

MYSQL_DATABASE=open_source_intelligence
MYSQL_USER=app
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_URL=mysql+pymysql://app:replace-with-a-local-database-password@mysql:3306/open_source_intelligence?charset=utf8mb4

REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-characters
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
GITHUB_API_BASE=https://api.github.com
HUGGINGFACE_API_BASE=https://hf-mirror.com/api

PIPELINE_SCHEDULE_ENABLED=true
PIPELINE_SCHEDULE_HOUR=2
PIPELINE_SCHEDULE_MINUTE=0
PIPELINE_COLLECT_LIMIT=20
PIPELINE_CONTENT_LIMIT=20
PIPELINE_TASK_MAX_RETRIES=2
PIPELINE_RETRY_BACKOFF_SECONDS=30

# Research Agent runtime.
# The default "offline" provider is a deterministic stub that needs no network or credential.
# Switch to "openai_compatible" only after filling AGENT_API_BASE and AGENT_API_KEY.
AGENT_ENABLED=true
AGENT_PROVIDER=offline
AGENT_MODEL=offline-deterministic-v1
AGENT_API_BASE=
AGENT_API_KEY=
AGENT_PROMPT_VERSION=v1
AGENT_MAX_LOOPS=4
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_TOKENS=30000
AGENT_MAX_COST=0.50
# Provider billing table, USD per one million tokens. DeepSeek's `usage` payload reports token
# counts but no amount, so `estimated_cost` only lands a real number when these are set. The
# defaults are DeepSeek's non-thinking (`deepseek-chat`) list price; change them for a different
# provider, not the code.
AGENT_INPUT_PRICE_PER_MTOK=0.14
AGENT_OUTPUT_PRICE_PER_MTOK=0.28
AGENT_MAX_CANDIDATES=5
AGENT_REQUEST_TIMEOUT_SECONDS=60
AGENT_PROMPTS_DIR=

# Automatic research dispatch (T24).
# The daily pipeline stops at ranking + README caching by default; research costs real budget,
# so it stays a deliberate act until this is switched on. When on, the daily task dispatches one
# research run per eligible topic, at most AGENT_DAILY_RESEARCH_LIMIT topics per business day.
# "Eligible" means: topic enabled, today's rank run succeeded with candidates, and no agent run
# has been started for that topic today (a re-delivered task must not charge twice).
# 研究跑完后自动成稿（组合 → 验证 → 按策略发布）。关掉就停在草稿，需要人工跑
# reports/cli.py --action generate —— 无人值守的一天只会留下草稿和空邮箱。
AGENT_AUTO_REPORT_ENABLED=true
AGENT_AUTO_RESEARCH_ENABLED=false
AGENT_DAILY_RESEARCH_LIMIT=2

# Risk-based publishing.
# AUTO_WITH_DELAY parks a report for this many minutes before it is published, so an
# operator still has a window to withdraw it. Reports below the citation coverage floor
# can never publish themselves and go to human review instead.
PUBLISH_DELAY_MINUTES=60
PUBLISH_MIN_CITATION_COVERAGE=1.0
PUBLISH_SWEEP_MINUTES=15

# Report delivery (email / Webhook).
# PUSH_DELIVERY=offline keeps the default transport deterministic and network-free, which is
# what every smoke and test run uses. Switch to "live" only after filling in the SMTP settings
# (for the email channel) or the signing secret (for the webhook channel); a live channel with
# missing credentials is refused before any delivery row is written.
# PUSH_MAX_ATTEMPTS bounds how many times a failed delivery is retried in place.
PUSH_ENABLED=true
PUSH_AUTO_AFTER_PUBLISH=true
PUSH_DELIVERY=offline
PUSH_MAX_ATTEMPTS=3
PUSH_RETRY_BACKOFF_SECONDS=60
PUSH_RETRY_INTERVAL_MINUTES=15
PUSH_TIMEOUT_SECONDS=20
PUSH_EMAIL_FROM=
PUSH_SMTP_HOST=
PUSH_SMTP_PORT=587
PUSH_SMTP_USERNAME=
PUSH_SMTP_PASSWORD=
PUSH_SMTP_STARTTLS=true
PUSH_WEBHOOK_SIGNING_SECRET=

# Test-only webhook escape hatches (refused in staging/production by config validation).
# A live webhook guard rejects loopback/private addresses to stop SSRF, which is exactly what a
# local receiver runs on. Flipping PUSH_WEBHOOK_ALLOW_PRIVATE_TARGETS lets a local/test deployment
# deliver to a 127.0.0.1 receiver to prove the transport and HMAC signing end to end; pair it with
# PUSH_WEBHOOK_CA_BUNDLE (a self-signed CA) so the delivery layer trusts the receiver's cert.
PUSH_WEBHOOK_ALLOW_PRIVATE_TARGETS=false
PUSH_WEBHOOK_CA_BUNDLE=

# Offline evaluation (T14).
# EVAL_ENABLED=false turns the whole evaluation layer off: `run_evaluation` and the API/CLI entry
# points then answer `EVALUATION_DISABLED` instead of executing the Agent, so a deployment that
# does not want evaluation traffic can refuse it without a code change (default enabled).
# EVAL_REGRESSION_TOLERANCE is the slack a variant gets before a drop counts as a regression:
# `docs/evaluation.md` §8 fixes 2 percentage points, so 0.02 means a fall of more than 2 points
# between a variant and its reference is reported as a regression.
EVAL_ENABLED=true
EVAL_REGRESSION_TOLERANCE=0.02

PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
