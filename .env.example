APP_ENV=local
APP_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCS_ENABLED=true

API_HOST=0.0.0.0
API_PORT=8000

MYSQL_DATABASE=open_source_intelligence
MYSQL_USER=app
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DATABASE_URL=mysql+pymysql://app:replace-with-a-local-database-password@mysql:3306/open_source_intelligence?charset=utf8mb4

REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-random-secret-of-at-least-32-characters

PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

